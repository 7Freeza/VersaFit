# ARCHIVO: backend/.env.example
# CAPA: Configuración de entorno (plantilla)
# CONECTA CON:
#   - Copiar a .env en la raíz de backend/
#   - Leído por: server.js, src/config/db.config.js, auth.middleware.js, auth.service.js (dotenv)
# RESPONSABILIDAD: Definir variables para servidor, MySQL, JWT y CORS del frontend.
# ENDPOINTS / TABLAS / DATOS:
#   - DB_NAME: base de datos MySQL (proyecto_integrador)
#   - JWT_SECRET: firma de tokens Bearer
#   - CORS_ORIGIN: origen permitido del SPA
# NOTAS: No commitear .env real. Cambiar JWT_SECRET en producción.

PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=proyecto_integrador
JWT_SECRET=cambia_este_secreto_en_produccion
CORS_ORIGIN=http://localhost:5173